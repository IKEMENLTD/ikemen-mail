# Standard Mailer — server-side environment variables
#
# These belong in Netlify's environment variables (and a local .env for
# `netlify dev`). Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: The browser-side public values (the Supabase project URL and the
# public ANON key) do NOT live here. They live in public/config.js
# (see public/config.example.js). Those are public-safe and protected by
# Row Level Security — the ANON key is meant to be shipped to the browser.

# Supabase project URL (e.g. https://xxxxxxxx.supabase.co).
# Also used in public/config.js for the browser.
SUPABASE_URL=

# Supabase service_role key — SERVER ONLY SECRET.
# Set as a Netlify env var only. Never commit it. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key — SERVER ONLY SECRET for sending email.
RESEND_API_KEY=

# Verified sender address used as the "From" header.
# Defaults to kouda@ikemen.ltd in code if left unset.
# NOTE: the domain (ikemen.ltd) must be verified in your Resend account,
# otherwise Resend will reject the send.
FROM_EMAIL=kouda@ikemen.ltd

# Optional shared secret for the /inbound webhook.
# Incoming requests must present it via the x-inbound-secret header.
# Leave empty to disable the inbound endpoint.
INBOUND_SECRET=
