# Supabase project URL (e.g. https://xxxxxxxx.supabase.co)
SUPABASE_URL=

# Supabase service_role key — SERVER-ONLY SECRET.
# Bypasses Row Level Security. Set this in the Netlify dashboard env vars; never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key — SERVER-ONLY SECRET.
# Set this in the Netlify dashboard env vars; never commit it.
RESEND_API_KEY=

# Verified sender address used as the "From" header (e.g. noreply@yourdomain.com)
FROM_EMAIL=
