# Standard Mailer — server-side environment variables
#
# These are Netlify environment variables. Copy this file to .env for local
# development with `netlify dev`:
#   cp .env.example .env
#
# NOTE: There is NO browser-side Supabase config anymore. The old
# public/config.js (Supabase URL + anon key for the browser) has been REMOVED.
# The browser never connects to Supabase directly — it only calls Netlify
# Functions. All values below are server-side only.

# Supabase project URL (e.g. https://xxxxxxxx.supabase.co).
SUPABASE_URL=

# Supabase service_role key — SERVER ONLY SECRET.
# Bypasses Row Level Security. Set as a Netlify env var only.
# Never commit a real value publicly.
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key — SERVER ONLY SECRET for sending email.
RESEND_API_KEY=

# Verified sender address used as the "From" header.
# The domain must be verified in your Resend account, otherwise Resend rejects
# the send.
FROM_EMAIL=kouda@ikemen.ltd

# Login password for the single-password gate.
# Set this in Netlify environment variables.
# SECURITY NOTE: this value is recorded here per request. If this repo is
# shared, rotate it — and prefer setting it ONLY in Netlify rather than
# committing it here.
LOGIN_PASSWORD=H61jia75qyvAh

# Optional HMAC signing secret for session tokens.
# Defaults to LOGIN_PASSWORD if unset. Recommended: set a long random value
# in production.
SESSION_SECRET=

# Optional shared secret for the /inbound webhook.
# Incoming requests must present it via the x-inbound-secret header.
# Leave empty to disable the inbound endpoint.
INBOUND_SECRET=
